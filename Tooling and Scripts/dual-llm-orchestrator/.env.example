# Copy this to .env in the same directory and fill in real values.
# .env is gitignored — create/edit it in a text editor directly, never via
# a `!` shell command (that echoes the full command, secret included, into
# the session transcript). config.py loads it automatically at import time.

ANTHROPIC_API_KEY=sk-ant-...
LOCAL_WORKER_BASE_URL=http://localhost:8000/v1
LOCAL_WORKER_MODEL=Qwen2.5-Coder-32B-Instruct
LOCAL_WORKER_API_KEY=not-needed

# Only needed for execute_exploit(reverse_shell=true):
ATTACKER_IP=10.10.14.5

# Cost controls (see README.md's "Cost controls" section for the full
# story on why these exist -- a real run burned ~$20 before they did):
MAX_RUN_COST_USD=5.00
# ANTHROPIC_EFFORT=medium
MAX_PLANNER_ITERATIONS=40
